{
  "name": "decluttering-selector",
  "version": "0.2.2",
  "private": true,
  "description": "Registers your decluttering-card templates into Home Assistant's native Add Card picker",
  "type": "module",
  "engines": {
    "node": ">=22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "changeset:add": "node scripts/add-changeset.mjs",
    "version": "changeset version"
  },
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "happy-dom": "^15.11.0",
    "typescript": "^5.6.0",
    "vite": "8.2.1",
    "vitest": "^2.1.0"
  }
}
